# Text files are stored with LF. WoW, Lua 5.1, Node and PowerShell 5.1+ all read LF files.
* text=auto eol=lf

*.lua      text eol=lf
*.toc      text eol=lf
*.xml      text eol=lf
*.ps1      text eol=lf
*.psm1     text eol=lf
*.ts       text eol=lf
*.js       text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.cs       text eol=lf
*.csproj   text eol=lf
# Windows-only script types that need CRLF, if any are added later
*.cmd      text eol=crlf
*.bat      text eol=crlf

# Binary assets
*.tga      binary
*.png      binary
*.ttf      binary
*.ico      binary
*.dll      binary
*.exe      binary
